  "incident_remediation": [
    "tail -n 500 /var/log/messages",
    "grep -i error /var/log/syslog | tail -100",
    "dmesg | tail -100",
    "sudo systemctl status sshd",
    "sudo last -a -n 30",
    "uptime",
    "df -h",
    "vmstat 1 5"
