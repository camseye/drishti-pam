{
  "_doc": "SSH command pools per ticket category. Keys are ticket categories; values are lists of realistic command strings. The 'suspicious' pool is reused for out-of-scope sessions and scope-creep scenarios.",
  "application_restart": [
    "sudo systemctl status tomcat",
    "sudo systemctl stop tomcat",
    "sudo systemctl start tomcat",
    "sudo systemctl restart tomcat",
    "sudo journalctl -u tomcat -n 200",
    "ps -ef | grep tomcat | grep -v grep",
    "curl -s http://localhost:8080/health",
    "tail -f /var/log/tomcat/catalina.out",
    "df -h /var/log",
    "free -m"
  ],
  "os_patching": [
    "sudo yum check-update",
    "sudo yum update -y --security",
    "sudo dnf upgrade --refresh -y",
    "uname -r",
    "rpm -qa --last | head -50",
    "sudo systemctl daemon-reexec",
    "sudo reboot",
    "uptime",
    "cat /etc/redhat-release"
  ],
  "network_config": [
    "ip a",
    "ip route show",
    "sudo iptables -L -n -v",
    "sudo nft list ruleset",
    "ping -c 4 10.0.0.1",
    "traceroute 10.0.0.1",
    "ss -tunlp",
    "sudo systemctl restart networking",
    "ethtool eth0"
