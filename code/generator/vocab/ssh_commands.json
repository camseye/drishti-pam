  "certificate_rotation": [
    "sudo openssl x509 -in /etc/ssl/certs/star.example.com.pem -noout -dates",
    "sudo cp /etc/ssl/certs/star.example.com.pem /etc/ssl/certs/star.example.com.pem.bak",
    "sudo cp /tmp/star.example.com.new.pem /etc/ssl/certs/star.example.com.pem",
    "sudo systemctl reload nginx",
    "curl -vI https://localhost",
    "openssl s_client -connect localhost:443 -showcerts < /dev/null"
